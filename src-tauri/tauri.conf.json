{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "虾虾发布助手",
  "version": "0.1.0",
  "identifier": "top.antarcticheifer.xiaxia.publish",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "虾虾发布助手",
        "width": 1120,
        "height": 820,
        "minWidth": 960,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
